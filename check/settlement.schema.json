{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settlement.schema.json",
  "title": "Claimwell settlements file",
  "description": "The one definition of a settlement record. The pipeline validates every record against it before publishing, and the app validates every record it loads. Change it here only; publish copies it next to the data file. Bump schemaVersion for any change an older app can't read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generated", "settlements"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generated": { "$ref": "#/$defs/date", "description": "Day the file was published" },
    "synonyms": {
      "type": "object",
      "description": "Search vocabulary: an everyday word or phrase people type, and the words it should also match.",
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 60 }, "minItems": 1 }
    },
    "settlements": { "type": "array", "items": { "$ref": "#/$defs/settlement" } }
  },
  "x-reservedReadyKeys": {
    "pay": "The payment method the person picks on the official form. Always a choice whose options come from paymentMethod. The tracker reads it.",
    "addresses": "Addresses the claim is about (for example rental units). Templates refer to it as {addresses}."
  },
  "x-profileKeys": ["name", "address", "email", "phone"],
  "x-reviewerOnlyPhrases": ["form not reviewed", "needs review", "reviewer", "todo", "tbd", "lorem ipsum", "fixme"],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "dateOrNull": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "httpsUrl": { "type": "string", "maxLength": 300, "pattern": "^https://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(:\\d+)?([/?#][^\\s<>\"]*)?$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "stateCode": { "enum": ["AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY","DC","PR","GU","VI"] },
    "paymentMethod": { "enum": ["PayPal", "Venmo", "Zelle", "Virtual prepaid card", "Paper check", "Account credit"] },
    "category": { "enum": ["Data breach", "Privacy", "Product", "Fees & billing", "Banking & credit", "Auto", "Insurance", "Housing", "Health care", "Food & drink"] },
    "topic": {
      "enum": ["broad", "health", "cars", "money", "shopping", "home", "travel", "tech", "school"],
      "description": "Everyday topic for the guided check. 'broad' doors are asked to everyone; the rest only if the person picks that topic.",
      "x-labels": {
        "broad": "Things lots of people do",
        "health": "Doctors, hospitals or prescriptions",
        "cars": "A car or car insurance",
        "money": "Banks, cards, credit or investing",
        "shopping": "Things you bought",
        "home": "Renting a home",
        "travel": "Travel, tickets or theme parks",
        "tech": "Phones, apps or games",
        "school": "A college or university"
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "ok", "no"],
      "properties": {
        "q": { "type": "string", "minLength": 5, "maxLength": 240 },
        "ok": { "enum": ["yes", "no"], "description": "The answer that qualifies" },
        "no": { "type": "string", "minLength": 5, "maxLength": 240, "description": "Why the other answer rules the person out" },
        "unsure": { "type": "string", "maxLength": 300, "description": "How to check" },
        "sameAsDoor": { "type": "boolean", "description": "true if a yes to the door question already answers this one with the qualifying answer" }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "group", "label", "note"],
      "properties": {
        "q": { "type": "string", "minLength": 5, "maxLength": 200, "description": "One everyday yes/no question" },
        "group": { "$ref": "#/$defs/topic" },
        "label": { "type": "string", "minLength": 2, "maxLength": 60, "description": "Tap-to-select label" },
        "note": { "type": "string", "minLength": 2, "maxLength": 90, "description": "One-line qualifier under the label" }
      }
    },
    "readyField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "key", "src", "help"],
      "properties": {
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" },
        "src": { "enum": ["input", "choice"] },
        "help": { "type": "string", "maxLength": 300 },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paymentMethod" } }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "caption", "caseNo", "court", "administrator", "officialUrl", "deadline", "fund", "category", "status", "whosIn", "classPeriod", "states", "proof", "proofDetail", "payout", "needs", "questions", "aliases", "verification", "source", "caveat", "effort", "est", "hearing", "ready", "door", "checked"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
        "name": { "$ref": "#/$defs/shortText" },
        "short": { "type": "string", "minLength": 2, "maxLength": 32 },
        "caption": { "type": "string", "minLength": 3, "maxLength": 160, "description": "Court case name" },
        "caseNo": { "type": ["string", "null"], "maxLength": 60 },
        "court": { "type": ["string", "null"], "maxLength": 48, "description": "Short form, e.g. 'N.D. Cal.' or 'Placer County Superior Court, Cal.'" },
        "administrator": { "type": ["string", "null"], "maxLength": 80 },
        "officialUrl": { "anyOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "deadline": { "$ref": "#/$defs/dateOrNull", "description": "Claim deadline. Required unless status is auto." },
        "opens": { "$ref": "#/$defs/date", "description": "Only when status is soon" },
        "fund": { "type": ["string", "null"], "maxLength": 80 },
        "category": { "$ref": "#/$defs/category" },
        "status": { "enum": ["open", "soon", "auto", "closed"] },
        "whosIn": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 3, "maxLength": 300 } },
        "classPeriod": { "anyOf": [{ "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/date" } }, { "type": "null" }] },
        "states": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateCode" } }, { "type": "null" }] },
        "proof": { "enum": ["none", "notice_id", "optional", "required", "unconfirmed"] },
        "proofDetail": { "type": "string", "maxLength": 400 },
        "payout": { "type": "string", "maxLength": 600 },
        "needs": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } },
        "questions": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/question" } },
        "aliases": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^A-Z]+$" } },
        "verification": { "enum": ["official", "partial", "secondary"] },
        "source": { "type": "string", "maxLength": 80 },
        "caveat": { "type": ["string", "null"], "maxLength": 300 },
        "effort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "docs", "level"],
          "properties": {
            "minutes": { "type": "integer", "minimum": 0, "maximum": 120 },
            "docs": { "type": "string", "maxLength": 80 },
            "level": { "enum": ["none", "easy", "medium", "hard"] }
          }
        },
        "est": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lo", "hi", "text"],
          "properties": {
            "lo": { "type": ["number", "null"], "minimum": 0 },
            "hi": { "type": ["number", "null"], "minimum": 0 },
            "text": { "type": "string", "maxLength": 80 }
          }
        },
        "hearing": { "$ref": "#/$defs/dateOrNull" },
        "ready": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/readyField" } },
        "door": { "$ref": "#/$defs/door" },
        "checked": { "$ref": "#/$defs/date", "description": "Day the pipeline last re-read this settlement's sources" },
        "template": { "type": "string", "maxLength": 600, "description": "Message the person can send, with {placeholders} from x-profileKeys or this record's ready keys" }
      }
    }
  }
}
